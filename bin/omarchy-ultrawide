#!/usr/bin/env bash
# omarchy-ultrawide — ultrawide background packs for Omarchy.
#
#   install [RATIO] [--replace]   install a pack (auto-detects the monitor)
#   switch RATIO                  change to another pack
#   uninstall                     remove every file this installed
#   status                        per-monitor: what each screen shows
#   packs                         list downloaded packs
#   fetch [TAG]                   download packs (pinned, SHA-256 verified)
#   menu                          add rows to the Omarchy menu
#   menu-remove                   take those rows back out
#   fix-previews                  restore stock theme screenshots in the switcher
#   resolve [PATH]                JSON: pack variants of a background
#   enable | disable              swap in the monitor-aware renderer / restore stock
#
# RATIO: 32x9 (5120x1440) | 21x9 (3440x1440) | 21x9-1080p (2560x1080)
#
# Default mode ADDS images to ~/.config/omarchy/backgrounds/<theme>/ so they join
# the theme's cycle. --replace overlays them into
# ~/.config/omarchy/themes/<theme>/backgrounds/ under the stock names instead.
# Nothing under /usr/share/omarchy is ever touched.
set -euo pipefail

ID=io.github.johnsideserf.ultrawide-background
DATA=${OMARCHY_ULTRAWIDE_DATA:-$HOME/.local/share/omarchy-ultrawide}
PACKS="$DATA/backgrounds"
REPO=${OMARCHY_ULTRAWIDE_REPO:-johnsideserf/omarchy-ultrawide-background}
STATE_DIR="$HOME/.config/omarchy/ultrawide-backgrounds"
MANIFEST="$STATE_DIR/manifest"
META="$STATE_DIR/installed"
OMASTATE="$HOME/.local/state/omarchy/current"
MENU="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
RATIOS="32x9 5k2k 21x9-1600 21x9 21x9-1080p"

# Packs come from one reviewed, immutable release. `latest` is a moving target -
# the bytes behind it can be replaced after a review - so it is never the
# default, and every asset is checked against the SHA-256 recorded here before
# it is unpacked. A tampered asset, or a $OMARCHY_ULTRAWIDE_REPO pointed
# somewhere else, fails this check and is never extracted.
PINNED_TAG=v0.1.0
sha_for() {
  case $1 in
    32x9)       printf 390938dc136aea8278095a968da171345367e26b637b2687ccc785f48621348f;;
    5k2k)       printf 1cd6307a7a462dbc9ffd3008287258870b4fb7a78ddb00702301b2cbc56e7ecd;;
    21x9-1600)  printf 2bc3d406151782f1283ff6f70982603b210ffc02bb4b97ee3701507362bfecb4;;
    21x9)       printf eb8dae3a3d2af9bf28a5b8438dc18a75c91cc56b8adbb10252e78f9dfba8879d;;
    21x9-1080p) printf f43ee0299de979ab1df250f3967bdee9f0a3ba27a2a8b9c1e0190f35654a8eca;;
  esac
}
# The largest pack is ~182 MB compressed and ~177 MB / 92 files expanded.
MAX_DOWNLOAD_BYTES=$((320 * 1024 * 1024))
MAX_DOWNLOAD_SECONDS=1800
MAX_MEMBERS=512
MAX_EXPANDED_BYTES=$((512 * 1024 * 1024))

die() { echo "omarchy-ultrawide: $*" >&2; exit 1; }
usage() { sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; }
packs() { ls -1 "$PACKS" 2>/dev/null || true; }

detect() {
  command -v hyprctl >/dev/null 2>&1 || { echo 32x9; return; }
  local W H r
  read -r W H < <(hyprctl monitors -j 2>/dev/null | python3 -c '
import json, sys
try:
    m = json.load(sys.stdin)
    m = [x for x in m if x.get("focused")] or m
    print(m[0]["width"], m[0]["height"])
except Exception:
    print("0 0")')
  [ "${W:-0}" -gt 0 ] || { echo 32x9; return; }
  r=$(( W * 100 / H ))
  if   [ "$r" -ge 340 ]; then echo 32x9
  elif [ "$r" -ge 220 ] && [ "$r" -le 260 ]; then
    if   [ "$H" -ge 2000 ]; then echo 5k2k
    elif [ "$H" -ge 1520 ]; then echo 21x9-1600
    elif [ "$H" -gt 1080 ]; then echo 21x9
    else echo 21x9-1080p; fi
  else echo ""; fi
}

reapply_theme() {
  command -v omarchy >/dev/null 2>&1 || return 0
  local cur; cur=$(omarchy theme current 2>/dev/null || true)
  [ -n "$cur" ] && omarchy theme set "$cur" >/dev/null 2>&1 && echo "re-applied theme: $cur" || true
}

# Refuse anything that is not an ordinary image file or a directory inside the
# pack directory, and bound both the member count and the expanded size.
# Links matter especially: cmd_install copies members with `cp -f`, which
# follows symlinks, so a link member would otherwise pull an arbitrary file
# (a key, a config) out of $HOME and into a theme background directory.
# Sets ARCHIVE_FILES to the number of images accepted.
ARCHIVE_FILES=0
validate_archive() {
  local archive=$1 pack=$2 type size name members=0 total=0
  while IFS=$'\t' read -r type size name; do
    [ -n "$name" ] || continue
    case $type in
      d|-) ;;
      *) die "refusing $pack: member is not a regular file or directory: $name";;
    esac
    case $name in
      /*|../*|*/../*|*/..) die "refusing $pack: unsafe member path: $name";;
      "$pack"|"$pack"/*) ;;
      *) die "refusing $pack: member outside '$pack/': $name";;
    esac
    [ "$type" = - ] || continue
    case ${name,,} in
      *.jpg|*.jpeg|*.png|*.webp) ;;
      *) die "refusing $pack: member is not an image: $name";;
    esac
    case $size in
      ''|*[!0-9]*) die "refusing $pack: unreadable member size for: $name";;
    esac
    members=$((members + 1)); total=$((total + size))
    [ "$members" -le "$MAX_MEMBERS" ] \
      || die "refusing $pack: archive holds more than $MAX_MEMBERS files"
    [ "$total" -le "$MAX_EXPANDED_BYTES" ] \
      || die "refusing $pack: archive expands beyond $MAX_EXPANDED_BYTES bytes"
  done < <(tar --zstd -tvf "$archive" | awk '{
      name = ""
      for (i = 6; i <= NF; i++) name = name (i > 6 ? " " : "") $i
      printf "%s\t%s\t%s\n", substr($1, 1, 1), $3, name
    }')
  [ "$members" -gt 0 ] || die "refusing $pack: archive contains no images"
  ARCHIVE_FILES=$members
}

cmd_fetch() {
  local tag=${1:-$PINNED_TAG} url pack stage want have size
  command -v tar >/dev/null 2>&1 || die "tar is required"
  command -v sha256sum >/dev/null 2>&1 || die "sha256sum is required"
  mkdir -p "$PACKS"; cd "$PACKS"
  # a hard kill skips the EXIT trap, so clear any debris from a previous run
  rm -rf "$PACKS"/.stage.* "$PACKS"/*.part 2>/dev/null || true
  for pack in $RATIOS; do
    [ -d "$pack" ] && { echo "have $pack"; continue; }
    want=$(sha_for "$pack")
    if [ "$tag" != "$PINNED_TAG" ] || [ -z "$want" ]; then
      [ "${OMARCHY_ULTRAWIDE_ALLOW_UNVERIFIED:-0}" = 1 ] || die \
        "no recorded SHA-256 for '$pack' at tag '$tag'. This build only fetches the reviewed release ($PINNED_TAG); re-run without a tag, or set OMARCHY_ULTRAWIDE_ALLOW_UNVERIFIED=1 to accept an unverified download."
      want=""
    fi
    if [ "$tag" = latest ]; then
      url="https://github.com/$REPO/releases/latest/download/$pack.tar.zst"
    else
      url="https://github.com/$REPO/releases/download/$tag/$pack.tar.zst"
    fi
    echo "fetching $pack ..."
    stage=$(mktemp -d "$PACKS/.stage.XXXXXX") || die "cannot create a staging dir"
    # shellcheck disable=SC2064
    trap "rm -rf '$stage' '$PACKS/$pack.part'" EXIT
    curl --fail --silent --show-error --location \
         --proto '=https' --tlsv1.2 --max-redirs 5 \
         --connect-timeout 20 --max-time "$MAX_DOWNLOAD_SECONDS" \
         --speed-limit 1024 --speed-time 60 \
         --max-filesize "$MAX_DOWNLOAD_BYTES" \
         -o "$pack.part" "$url" || die "download failed: $url"
    # --max-filesize only fires when the server declares a length up front
    size=$(stat -c %s "$pack.part")
    [ "$size" -le "$MAX_DOWNLOAD_BYTES" ] \
      || die "refusing $pack: download exceeded $MAX_DOWNLOAD_BYTES bytes"
    if [ -n "$want" ]; then
      have=$(sha256sum "$pack.part" | cut -d' ' -f1)
      [ "$have" = "$want" ] \
        || die "refusing $pack: SHA-256 mismatch (expected $want, got $have)"
    else
      echo "  WARNING: unverified download (OMARCHY_ULTRAWIDE_ALLOW_UNVERIFIED=1)" >&2
    fi
    validate_archive "$pack.part" "$pack"
    tar --zstd -xf "$pack.part" -C "$stage" --no-same-owner --no-same-permissions \
      || die "could not unpack $pack"
    [ -d "$stage/$pack" ] || die "$pack archive did not contain a '$pack' directory"
    # move into place only once it is known-good, so an interrupted run never
    # leaves a partial directory that the next run mistakes for a full pack
    mv "$stage/$pack" "$PACKS/$pack"
    rm -rf "$stage" "$pack.part"; trap - EXIT
    echo "ok $pack ($ARCHIVE_FILES images)"
  done
}

cmd_uninstall() {
  [ -f "$MANIFEST" ] || { echo "nothing installed"; return 0; }
  local n=0 f
  while read -r f; do [ -f "$f" ] && rm -f "$f" && n=$((n+1)); done < "$MANIFEST"
  rm -f "$MANIFEST" "$META"
  find "$HOME/.config/omarchy/backgrounds" -type d -empty -delete 2>/dev/null || true
  cmd_menu_remove quiet
  echo "removed $n files"
}

cmd_install() {
  local ratio=${1:-} mode=add d slug dest f n=0
  [ "${2:-}" = "--replace" ] && mode=replace
  if [ -z "$ratio" ]; then
    ratio=$(detect)
    [ -n "$ratio" ] || die "this monitor is not ultrawide; pass a ratio explicitly ($(packs | tr '\n' ' '))"
    echo "detected monitor -> $ratio"
  fi
  [ -d "$PACKS/$ratio" ] || die "no pack '$ratio' downloaded (have: $(packs | tr '\n' ' ')); run: omarchy-ultrawide fetch"
  [ -f "$MANIFEST" ] && cmd_uninstall >/dev/null
  mkdir -p "$STATE_DIR"; : > "$MANIFEST"
  for d in "$PACKS/$ratio"/*/; do
    slug=$(basename "$d")
    if [ "$mode" = replace ]; then dest="$HOME/.config/omarchy/themes/$slug/backgrounds"
    else dest="$HOME/.config/omarchy/backgrounds/$slug"; fi
    mkdir -p "$dest"
    # An overlay theme dir with no preview makes the theme switcher fall back to
    # a background image AND still add the stock screenshot, so the theme shows
    # up twice (its de-duplication compares name+extension). Link the stock
    # preview in so the switcher keeps one entry, using the real screenshot.
    if [ "$mode" = replace ]; then
      stock_preview="/usr/share/omarchy/themes/$slug/preview.png"
      overlay_dir="$HOME/.config/omarchy/themes/$slug"
      if [ -f "$stock_preview" ] && ! ls "$overlay_dir"/preview.* >/dev/null 2>&1; then
        ln -sf "$stock_preview" "$overlay_dir/preview.png"
        echo "$overlay_dir/preview.png" >> "$MANIFEST"
      fi
    fi
    for f in "$d"*; do
      cp -f "$f" "$dest/$(basename "$f")"
      echo "$dest/$(basename "$f")" >> "$MANIFEST"; n=$((n+1))
    done
  done
  printf 'ratio=%s\nmode=%s\n' "$ratio" "$mode" > "$META"
  echo "installed $n backgrounds ($ratio, $mode)"
  reapply_theme
}

cmd_resolve() {
  local p=${1:-} key file dir parent slug r f g first=1
  [ -n "$p" ] || p=$(readlink -f "$OMASTATE/background" 2>/dev/null || true)
  [ -n "$p" ] || { echo '{}'; return; }
  file=$(basename "$p"); dir=$(dirname "$p"); parent=$(basename "$dir")
  if [ "$parent" = backgrounds ]; then slug=$(basename "$(dirname "$dir")"); else slug=$parent; fi
  [ "$dir" = "$OMASTATE/theme/backgrounds" ] && slug=$(cat "$OMASTATE/theme.name" 2>/dev/null || echo "$slug")
  key="$slug/$file"
  printf '{"path":"%s","key":"%s","variants":{' "$p" "$key"
  for r in $RATIOS; do
    f="$PACKS/$r/$key"
    if [ ! -f "$f" ]; then
      for ext in jpg jpeg png; do g="${f%.*}.$ext"; [ -f "$g" ] && { f=$g; break; }; done
    fi
    [ -f "$f" ] || f=""
    [ $first = 1 ] || printf ','; first=0
    printf '"%s":"%s"' "$r" "$f"
  done
  printf '}}\n'
}

cmd_status() {
  local bg; bg=$(readlink -f "$OMASTATE/background" 2>/dev/null || echo "?")
  echo "current background: $bg"
  echo "packs downloaded:   $(packs | tr '\n' ' ')"
  [ -f "$META" ] && echo "installed:          $(tr '\n' ' ' < "$META")" || echo "installed:          (none)"
  echo
  # Status data goes into a private mode-0700 directory, never a predictable
  # name in the shared /tmp: `>` follows symlinks, so a pre-created
  # /tmp/.uw-res.<pid> pointing at any user-writable file would be truncated.
  local rt res mon
  rt=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/omarchy-ultrawide.XXXXXX") \
    || die "cannot create a runtime directory"
  chmod 700 "$rt"
  # shellcheck disable=SC2064
  trap "rm -rf '$rt'" EXIT INT TERM HUP
  res="$rt/resolve.json"; mon="$rt/monitors.json"
  cmd_resolve "$bg" > "$res" 2>/dev/null || echo '{}' > "$res"
  hyprctl monitors -j > "$mon" 2>/dev/null || echo '[]' > "$mon"
  python3 - "$res" "$mon" <<'PY'
import json, os, sys
res = json.load(open(sys.argv[1])) if os.path.getsize(sys.argv[1]) else {}
mons = json.load(open(sys.argv[2])) if os.path.getsize(sys.argv[2]) else []
def cls(w, h):
    r = w * 100 // h
    if r >= 340: return "32x9"
    if 220 <= r <= 260:
        if h >= 2000: return "5k2k"
        if h >= 1520: return "21x9-1600"
        return "21x9" if h > 1080 else "21x9-1080p"
    return ""
if not mons:
    print("  (no monitors reported)"); raise SystemExit
print(f"  {'OUTPUT':10} {'RESOLUTION':13} {'PACK':12} SHOWS")
for m in mons:
    c = cls(m["width"], m["height"])
    v = res.get("variants", {}).get(c, "") if c else ""
    mark = " *" if m.get("focused") else "  "
    shows = f"{os.path.basename(v)}   [{c}]" if v else "stock image (no pack for this shape)"
    print(f"{mark}{m['name']:10} {m['width']}x{m['height']:<8} {c or '-':12} {shows}")
PY
  rm -rf "$rt"; trap - EXIT INT TERM HUP
}

cmd_menu() {
  mkdir -p "$(dirname "$MENU")"; [ -f "$MENU" ] || echo '{' > "$MENU"
  grep -q '"style.ultrawide"' "$MENU" 2>/dev/null && { echo "menu rows already present"; return 0; }
  python3 - "$MENU" "$(command -v omarchy-ultrawide || echo "$HOME/.local/bin/omarchy-ultrawide")" <<'PY'
import sys
path, cli = sys.argv[1], sys.argv[2]
s = open(path).read().rstrip()
rows = f'''
  // Ultrawide background packs
  "style.ultrawide": {{"icon":"\\udb81\\udd79","label":"Ultrawide backgrounds","description":"32:9 and 21:9 versions of the stock backgrounds"}},
  "style.ultrawide.32x9": {{"icon":"\\udb81\\udd7a","label":"32:9  (5120x1440)","action":"{cli} switch 32x9"}},
  "style.ultrawide.21x9": {{"icon":"\\udb81\\udd7a","label":"21:9  (3440x1440)","action":"{cli} switch 21x9"}},
  "style.ultrawide.21x9-1080p": {{"icon":"\\udb81\\udd7a","label":"21:9  (2560x1080)","action":"{cli} switch 21x9-1080p"}},
  "style.ultrawide.status": {{"icon":"\\udb80\\udcbe","label":"Status","action":"omarchy-launch-or-focus-tui \\"bash -c '{cli} status; read -n 1'\\""}},
  "style.ultrawide.uninstall": {{"icon":"\\udb80\\udd7a","label":"Remove pack","action":"{cli} uninstall"}}
'''
i = s.rfind('}')
body = s[:i].rstrip()
if not body.endswith('{') and not body.endswith(','):
    body += ','
open(path, 'w').write(body + rows + '}\n')
PY
  echo "menu rows added to $MENU (Style -> Ultrawide backgrounds); the menu hot-reloads"
}

cmd_menu_remove() {
  [ -f "$MENU" ] || return 0
  grep -q '"style.ultrawide' "$MENU" 2>/dev/null || return 0
  python3 - "$MENU" <<'PY'
import re, sys
path = sys.argv[1]
s = open(path).read()
# drop our comment line and every "style.ultrawide..." entry, leaving the rest
s = re.sub(r'\n\s*//[^\n]*Ultrawide background packs[^\n]*', '', s)
s = re.sub(r'\n\s*"style\.ultrawide[^"]*":\s*\{.*?\}\s*,?', '', s)
s = re.sub(r',(\s*\})', r'\1', s)          # tidy a trailing comma
open(path, 'w').write(s)
PY
  [ "${1:-}" = quiet ] || echo "menu rows removed from $MENU"
}

case "${1:-}" in
  install)   shift; cmd_install "${1:-}" "${2:-}";;
  switch)    [ -n "${2:-}" ] || die "switch needs a ratio"
             cmd_install "$2" "$([ "$(grep -s '^mode=' "$META" | cut -d= -f2)" = replace ] && echo --replace)";;
  uninstall) cmd_uninstall; reapply_theme;;
  status)    cmd_status;;
  packs)     packs;;
  fetch)     shift; cmd_fetch "${1:-$PINNED_TAG}";;
  menu)      cmd_menu;;
  menu-remove) cmd_menu_remove;;
  fix-previews)
             n=0
             for t in /usr/share/omarchy/themes/*/; do
               slug=$(basename "$t"); o="$HOME/.config/omarchy/themes/$slug"
               [ -d "$o" ] || continue
               ls "$o"/preview.* >/dev/null 2>&1 && continue
               [ -f "$t/preview.png" ] || continue
               ln -sf "$t/preview.png" "$o/preview.png"; n=$((n+1))
             done
             rm -rf "${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/theme-selector"
             echo "linked $n stock previews; switcher cache cleared";;
  resolve)   shift; cmd_resolve "${1:-}";;
  enable)    command -v omarchy >/dev/null 2>&1 || die "the 'omarchy' command is required"
             omarchy plugin enable "$ID" >/dev/null || die "could not enable $ID"
             # The manifest declares omarchy.clonedFrom, so the plugin registry
             # normally disables omarchy.background and remembers to restore it.
             # Only step in if it did not (an older shell, or a registry that has
             # not re-read the manifest yet).
             if grep -q '"omarchy.background"' "$HOME/.config/omarchy/shell.json" 2>/dev/null; then
               echo "ultrawide renderer enabled (registry swapped out omarchy.background)"
             else
               omarchy plugin disable omarchy.background >/dev/null 2>&1 || true
               echo "ultrawide renderer enabled (disabled omarchy.background manually;"
               echo "  run 'omarchy restart shell' so the registry picks up the manifest)"
             fi;;
  disable)   command -v omarchy >/dev/null 2>&1 || die "the 'omarchy' command is required"
             omarchy plugin disable "$ID" >/dev/null 2>&1 || true
             # the registry restores the source it disabled; make sure either way
             grep -q '"omarchy.background"' "$HOME/.config/omarchy/shell.json" 2>/dev/null \
               && omarchy plugin enable omarchy.background >/dev/null 2>&1 || true
             echo "stock omarchy.background restored";;
  -h|--help|"") usage;;
  *)         die "unknown command: $1";;
esac
